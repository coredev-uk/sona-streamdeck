{
	"name": "sona-streamdeck",
	"private": true,
	"description": "Control Sona, the Apple Music desktop client, from a Stream Deck.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "rolldown -c rolldown.config.ts",
		"watch": "rolldown -c rolldown.config.ts -w",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"assets": "node scripts/assets.ts",
		"validate": "streamdeck validate uk.coredev.sona.sdPlugin",
		"pack": "streamdeck pack uk.coredev.sona.sdPlugin --output dist --force",
		"check": "npm run typecheck && npm test && npm run build && npm run validate"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.4",
		"@elgato/utils": "0.6.2",
		"jpeg-js": "0.4.4"
	},
	"devDependencies": {
		"@elgato/cli": "1.10.4",
		"@resvg/resvg-js": "2.6.2",
		"@types/node": "24.19.2",
		"@types/ws": "8.18.2",
		"rolldown": "1.3.2",
		"typescript": "5.9.3",
		"ws": "8.19.0"
	}
}
